# SG16 Finance — variable/secret inventory. NEVER put real values in this file.
# Production values belong in Cloudflare Worker secrets (`wrangler secret put NAME`)
# or the Workers & Pages -> Settings -> Variables and Secrets dashboard.
# Local dev may use .env.local / .dev.vars (both gitignored).

# ---- Local only -------------------------------------------------------------
# SQLite file used by `npm run dev` (production uses the D1 binding `DB`).
LOCAL_DATABASE_URL=file:.data/sg16finance.db

# ---- Required on the main Worker `sg16finance` ------------------------------
# AES-256-GCM session cookie key, minimum 32 characters. Rotating logs everyone out.
SESSION_SECRET=
# Cloudflare Turnstile (site key is public; secret key is server-side).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Resend: sends the 6-digit email verification codes. Without it sign-in fails closed.
RESEND_API_KEY=
# Optional sender override (default: SG16 Finance <login@sg16finance.com>).
AUTH_FROM_EMAIL=

# ---- Payments (Dodo) --------------------------------------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# "test" (default) or "live"
DODO_ENV=test
# For live mode, override the test product ids:
DODO_PRODUCT_VIP=
DODO_PRODUCT_INSTITUTIONAL=
DODO_PRODUCT_DAY5=
DODO_PRODUCT_DAY12=
DODO_PRODUCT_WEEK=

# ---- Webhooks / market data -------------------------------------------------
# Must match the secret shown in the Finnhub dashboard.
FINNHUB_WEBHOOK_SECRET=
# Required on the CRON Worker `sg16finance-cron` (not the main Worker).
FINNHUB_API_KEY=

# ---- Optional AI engines (copilot falls back to Cloudflare Workers AI) ------
# AI_PROVIDER=sg16|mistral|workers
AI_PROVIDER=
AI_WORKERS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
SG16_BRAIN_KEY=
# Defaults to https://mistralbrain.com — a THIRD PARTY. Prompts + last 2 chat turns
# are sent there when this engine is used. Disclose in the privacy notice.
SG16_BRAIN_URL=

# ---- Optional support notification -----------------------------------------
SUPPORT_NOTIFY_EMAIL=

# ---- MUST NEVER be set in production ----------------------------------------
# AUTH_DEV_LOG_CODE=1 prints login codes to the console when RESEND_API_KEY is absent.
# CRON_SECRET belonged to the discarded 2026-11-12 experiment; it is not used by HEAD.
# AUTH_DEV_LOG_CODE=
# CRON_SECRET=
