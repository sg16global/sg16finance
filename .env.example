# Copy to .env.local for dev. Set same keys in Cloudflare Pages → Settings → Environment variables.

# Finnhub (live quotes + ticker)
# FINNHUB_API_KEY=your_key

# Google AdSense (build-time — must prefix VITE_)
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT_HOME_MID=1234567890
# VITE_ADSENSE_SLOT_HOME_BOTTOM=1234567891
# VITE_ADSENSE_SLOT_PAGE_TOP=1234567892
# VITE_ADSENSE_SLOT_PAGE_BOTTOM=1234567893
