# Optional: local SQLite file for `npm run dev` (Cloudflare D1 is used in production)
LOCAL_DATABASE_URL=file:.data/sg16finance.db

# Finnhub webhook: must match the secret shown in the Finnhub dashboard.
# In production set it as a Cloudflare secret: wrangler secret put FINNHUB_WEBHOOK_SECRET
FINNHUB_WEBHOOK_SECRET=

# Dodo Payments (set as Cloudflare secrets in production; never commit real values)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# "test" (default) or "live"
DODO_ENV=test
# For live mode, override the test product ids: DODO_PRODUCT_VIP, DODO_PRODUCT_INSTITUTIONAL,
# DODO_PRODUCT_DAY5, DODO_PRODUCT_DAY12, DODO_PRODUCT_WEEK
