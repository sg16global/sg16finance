{
  // DEPRECATED 2026-10-30 — kept for reference only.
  // Current Wrangler hard-errors when `.cloudflare/output` exists (this project builds for the
  // `cf` CLI), so this config can no longer deploy. Use `npm run deploy` / `npm run deploy:prebuilt`
  // (`cf deploy [--prebuilt]`) instead. See OPS-RUNBOOK.md part 2.
  //
  // Deploy config for the vinext build output. Usage: npm run build:vinext && npm run deploy:wrangler
  "name": "sg16finance",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "sg16finance.com", "custom_domain": true },
    { "pattern": "www.sg16finance.com", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "RL_ACCESS", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_CHECKOUT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 8, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "sg16finance-db", "database_id": "8671a510-3431-41ad-be92-cdcb3faa3f72" }
  ]
}
